# ==============================================
# CONFIGURATION SPARCKY (Bot + API + Panel)
# ==============================================

# --- BASE DE DONNÉES ---
# En local avec docker-compose: mongodb://mongo:27017/sparcky
# Ou URI MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/sparcky
MONGODB_URI=mongodb://mongo:27017/sparcky
MONGODB_DB=sparcky

# --- DISCORD BOT ---
TOKEN=ton_token_de_bot_discord_ici
CLIENT_ID=ton_client_id_discord
GUILD_ID=ton_serveur_de_test_id

# --- DISCORD OAUTH2 (API & PANEL) ---
DISCORD_CLIENT_ID=ton_client_id_discord
DISCORD_CLIENT_SECRET=ton_client_secret_discord
# En local : http://localhost:3001/auth/discord/callback
# En production sur VPS : https://panel.ton-domaine.fr/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# --- SÉCURITÉ API ---
PORT=3001
JWT_SECRET=change_moi_avec_une_chaine_aleatoire_tres_longue_et_securisee
FRONTEND_URL=http://localhost:5173
